{
  "name": "js-openfort-sdk",
  "version": "0.0.0",
  "author": "Openfort (https://www.openfort.io)",
  "bugs": "https://github.com/openfort-xyz/openfort-js/issues",
  "homepage": "https://github.com/openfort-xyz/openfort-js#readme",
  "repository": "github.com/openfort-xyz/openfort-js.git",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --filter='!{./examples/**}' test",
    "test-e2e": "pnpm --filter nextjs test",
    "test-e2e-ui": "pnpm --filter nextjs test-ui",
    "test:unit": "pnpm --filter @openfort/openfort-js test:unit",
    "test:watch": "pnpm --filter @openfort/openfort-js test:watch",
    "test:coverage": "pnpm --filter @openfort/openfort-js test:coverage",
    "preinstall": "pnpx only-allow pnpm",
    "verify": "pnpm audit && pnpm check:repo && pnpm biome check && pnpm check:types && pnpm test:coverage && pnpm knip --production && pnpm build && pnpm test:build && pnpm test:env && pnpm build:docs && pnpm size",
    "check": "biome check",
    "check:fix": "biome check --write --unsafe",
    "check:repo": "sherif",
    "check:types": "tsc --noEmit -p sdk/tsconfig.json && tsc --noEmit -p packages/internal/openapi-clients/tsconfig.json",
    "clean": "rm -rf sdk/dist",
    "check:unused": "pnpm clean && knip",
    "postinstall": "simple-git-hooks && ./.husky/install_gitleaks.sh",
    "scan:secrets": "./.husky/run_gitleaks.sh",
    "stats": "pnpm --filter @openfort/openfort-js stats",
    "dev": "pnpm --filter @openfort/openfort-js dev",
    "dev:nextjs": "pnpm --filter nextjs dev",
    "dev:firebase": "pnpm --filter firebase-next-app dev",
    "dev:solana": "pnpm --filter solana-vite dev",
    "dev:wagmi-vite": "pnpm --filter wagmi-vite dev",
    "dev:wagmi": "pnpm --filter wagmi-next-app dev",
    "build": "NODE_OPTIONS=--max-old-space-size=14366 pnpm -r --filter @openfort/openfort-js... build",
    "build:docs": "typedoc --json docs/spec.json",
    "build:nextjs": "pnpm build && pnpm --filter nextjs build",
    "build:solana": "pnpm build && pnpm --filter solana-vite build",
    "build:firebase": "pnpm build && pnpm --filter firebase-next-app build",
    "build:wagmi": "pnpm build && pnpm --filter wagmi-next-app build",
    "build:platform-bridge": "pnpm build && pnpm --filter platform-bridge build",
    "changeset": "changeset",
    "changeset:version": "pnpm install --lockfile-only && changeset version && cp sdk/CHANGELOG.md CHANGELOG.md && cd sdk && node copyVersion.cjs",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:prepublish": "pnpm build",
    "test:build": "publint --strict ./sdk && attw --pack ./sdk",
    "test:env": "pnpm --filter test-tsc test",
    "size": "pnpm --filter @openfort/openfort-js size"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.11",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.61.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@size-limit/preset-small-lib": "11.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "knip": "^5.88.1",
    "publint": "^0.3.18",
    "sherif": "^0.8.4",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "11.2.0",
    "stream-browserify": "^3.0.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vm-browserify": "^1.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "./.husky/run_gitleaks.sh && pnpm check --staged --no-errors-on-unmatched"
  },
  "workspaces": {
    "packages": [
      "packages/**",
      "sdk",
      "examples/**",
      "test"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.0",
      "@types/react-dom": "^18.3.0",
      "@vanilla-extract/sprinkles": "1.6.4",
      "micromatch@<4.0.8": ">=4.0.8",
      "cookie@<0.7.0": ">=0.7.0",
      "@metamask/sdk-communication-layer@>=0.16.0 <=0.33.0": ">=0.33.1",
      "@metamask/sdk@>=0.16.0 <=0.33.0": ">=0.33.1",
      "hono": ">=4.12.27",
      "react-router@<7.18.0": ">=7.18.0 <8",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "next": ">=16.2.11",
      "fast-xml-parser": ">=5.7.0",
      "axios": ">=1.18.0",
      "minimatch": ">=10.2.3",
      "bn.js": ">=5.2.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "@tootallnate/once@<3.0.1": ">=3.0.1",
      "socket.io-parser@>=4.0.0 <4.2.6": ">=4.2.6",
      "h3@<1.15.6": ">=1.15.6",
      "node-forge@<1.4.0": ">=1.4.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "vm-browserify": "^1.1.2",
      "protobufjs": ">=8.6.6",
      "ws": ">=8.21.0",
      "fast-xml-builder": ">=1.1.7",
      "uuid": ">=11.1.1",
      "postcss": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0",
      "websocket-driver@<0.7.5": ">=0.7.5",
      "smol-toml@<1.6.1": ">=1.6.1",
      "brace-expansion": ">=5.0.8",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "defu@<=6.1.4": ">=6.1.5",
      "tmp@<0.2.6": ">=0.2.6",
      "@grpc/grpc-js": ">=1.14.4",
      "form-data": ">=4.0.6",
      "js-yaml@<4.3.0": ">=4.3.0 <5",
      "@babel/core@<=7.29.0": ">=7.29.6"
    },
    "auditConfig": {
      "_comment": "Every entry needs a reason and a removal condition. Suppressions without one rot into permanent blind spots.",
      "ignoreCves": [
        "CVE-2025-14505"
      ],
      "_ignoreGhsasReasons": {
        "GHSA-qwww-vcr4-c8h2": "react-router RSC-mode CSRF bypass. Fixed in 8.3.0, but examples/apps/wallet-libraries/vite-wagmi pins react-router-dom@7.x, which requires react-router 7.x -- forcing 8.3.0 creates a major-version mismatch. Dev/example dependency only; NOT in the published SDK tree. Remove once that example moves to react-router-dom 8."
      },
      "_ignoreCvesReasons": {
        "CVE-2025-14505": "elliptic@6.6.1, reached via @ethersproject/signing-key, i.e. it SHIPS to consumers in the ECDSA signing path. No upstream fix exists and no override can resolve it. Removable only by dropping @ethersproject/* -- tracked as the ethers v5 removal."
      },
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    },
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  },
  "knip": {
    "ignore": [
      ".github/**",
      ".husky/**",
      ".parcel-cache/**",
      "**/.next/**",
      "**/dist/**",
      "**/stats.html"
    ],
    "ignoreBinaries": [
      "open",
      "simple-git-hooks"
    ],
    "ignoreDependencies": [
      "buffer",
      "crypto-browserify",
      "events",
      "stream-browserify",
      "vm-browserify"
    ],
    "ignoreWorkspaces": [
      "examples/**",
      "test/**",
      "packages/platform-bridge"
    ],
    "vitest": {
      "config": [
        "sdk/vitest.config.ts"
      ],
      "entry": [
        "**/*.{test,spec}.?(c|m)[jt]s?(x)"
      ]
    },
    "workspaces": {
      ".": {
        "entry": [
          "rollup.config.js!",
          "typedoc.json!"
        ]
      },
      "sdk": {
        "entry": [
          "src/index.ts!"
        ],
        "ignore": [
          "version.ts",
          "copyVersion.cjs",
          "vitest.config.ts",
          "scripts/**",
          "src/__tests__/**"
        ],
        "ignoreDependencies": [
          "axios-retry"
        ]
      },
      "packages/internal/openapi-clients": {
        "entry": [
          "src/backend-api-clients.ts!",
          "src/backend/index.ts!"
        ],
        "ignore": [
          "src/backend-openapi.json",
          "scripts/**"
        ]
      }
    }
  },
  "sideEffects": false
}
