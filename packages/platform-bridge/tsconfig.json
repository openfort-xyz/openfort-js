{
  "compilerOptions": {
    // es2022 matches the sdk this package bundles in: its dependency
    // `@openfort/openfort-js` is compiled at es2022, so an ES5 target here
    // never actually downlevelled the shipped bundle. ES5 is also deprecated
    // from TypeScript 6.
    "target": "es2022",
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    // Bundled by rollup, like the sdk: extensionless relative imports and
    // dependency `exports` maps are what the build actually resolves. No
    // `baseUrl` — the only non-relative imports are real packages, and
    // `baseUrl` is deprecated from TypeScript 6.
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "removeComments": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
