auto-install-peers=false
enable-pre-post-scripts=true
provenance=true
strict-peer-dependencies=false
save-exact=true
# The project's own lifecycle scripts must run: `preinstall` enforces pnpm and
# `postinstall` installs the git hooks and gitleaks. Dependency scripts stay
# blocked via ignore-dep-scripts (and pnpm's default build-allowlist).
ignore-scripts=false
ignore-dep-scripts=true
