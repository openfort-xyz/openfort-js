{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  // Tests and mocks are excluded from the published build; vitest types in
  // declaration emit produce non-portable inferred types (TS2742). They are
  // still type-checked via tsconfig.json.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test-d.ts", "src/**/*.spec.ts", "src/__tests__/**"]
}
